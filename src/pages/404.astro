---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Page not found · Peter Salmon" description="This page doesn’t exist." noindex>
  <SiteHeader />
  <main id="main" tabindex="-1" class="wrap not-found">
    <h1>Page not found</h1>
    <p>The link may be old, or the page has moved.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Go to the homepage <Icon name="arrow-right" size={17} /></a>
      <a class="btn btn-ghost" href="/work/">See my work</a>
    </div>
  </main>
  <SiteFooter />
</Base>
