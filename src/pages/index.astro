---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ProjectCards from "../components/ProjectCards.astro";
import Icon from "../components/Icon.astro";
import harbourMap from "../assets/atlas/victoria-harbour.svg";
import portrait from "../assets/portrait.jpg";
import { site } from "../data/site";

const title = "Peter Salmon · Building Urbora in Victoria, BC";
const description =
  "Peter Salmon leads Fernwood Agentic in Victoria, British Columbia, where he is building Urbora to make land-use research easier. He also works on Polity and Munify.";
const origin = site.url;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${origin}/#website`,
      url: `${origin}/`,
      name: "Peter Salmon",
      inLanguage: "en-CA",
      publisher: { "@id": `${origin}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${origin}/#person`,
      name: "Peter Salmon",
      url: `${origin}/`,
      image: new URL(portrait.src, origin).href,
      jobTitle: "CEO, Fernwood Agentic",
      description,
      email: `mailto:${site.email}`,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Victoria",
        addressRegion: "BC",
        addressCountry: "CA",
      },
      worksFor: [
        { "@type": "Organization", name: "Fernwood Agentic", url: site.fernwood },
        { "@type": "Organization", name: "Polity Cooperative", url: site.polity },
      ],
      knowsAbout: [
        "Land use",
        "Zoning",
        "Municipal records",
        "Software development",
        "Artificial intelligence",
        "Product design",
        "Public engagement",
      ],
      sameAs: [site.linkedin],
    },
    {
      "@type": "SoftwareApplication",
      name: "Urbora",
      url: site.urbora,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      description:
        "The connected platform for land use intelligence. Ask Urbora anything about a site and it answers in plain language from the city's own documents, with every source cited.",
      publisher: { "@type": "Organization", name: "Fernwood Agentic", url: site.fernwood },
    },
  ],
};
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <SiteHeader current="home" />

  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <Image
            class="portrait"
            src={portrait}
            alt="Peter Salmon"
            widths={[184, 368, 552]}
            sizes="(max-width: 760px) 136px, 184px"
            width={184}
            height={184}
            format="webp"
            quality={82}
            loading="eager"
          />
          <h1 id="hero-title">Peter Salmon</h1>
          <p class="hero-place">{site.location}</p>
          <p class="hero-intro">
            I lead <a class="text-link" href={site.fernwood}>Fernwood Agentic</a>, where we’re building
            <a class="text-link" href={site.urbora}>Urbora</a> to make land-use research easier.
          </p>
        </div>
      </div>
      <div class="hero-map" aria-hidden="true">
        <img src={harbourMap.src} width="1800" height="1040" alt="" decoding="async" fetchpriority="high" />
      </div>
    </section>

    <section class="section" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <h2 class="h-section h-section--lg" id="work-title">My work</h2>
        <ProjectCards />
        <div class="section-foot">
          <a class="btn btn-ghost" href="/work/#earlier">Earlier work <Icon name="arrow-right" size={17} /></a>
          <a class="btn btn-ghost" href="/about/">About me <Icon name="arrow-right" size={17} /></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
