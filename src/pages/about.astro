---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import portrait from "../assets/portrait.jpg";
import { site } from "../data/site";

const title = "About · Peter Salmon";
const description =
  "Peter Salmon is the CEO of Fernwood Agentic in Victoria, BC, where he builds Urbora. He previously worked with historical land records at BC’s Land Title and Survey Authority.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${site.url}/about/#page`,
  url: `${site.url}/about/`,
  name: title,
  description,
  isPartOf: { "@id": `${site.url}/#website` },
  mainEntity: { "@id": `${site.url}/#person` },
};
---

<Base title={title} description={description} path="/about/" jsonLd={jsonLd}>
  <SiteHeader current="about" />

  <main id="main" tabindex="-1" class="wrap about-page">
    <h1 class="page-title">About</h1>
    <div class="about-grid">
      <Image
        class="about-portrait"
        src={portrait}
        alt="Peter Salmon"
        widths={[320, 480, 640, 800]}
        sizes="(max-width: 760px) calc(100vw - 40px), 360px"
        format="webp"
        quality={80}
        loading="eager"
      />
      <div class="about-body">
        <p>
          I lead <a class="text-link" href={site.fernwood} target="_blank" rel="noopener">Fernwood Agentic</a>, where we’re building
          <a class="text-link" href={site.urbora} target="_blank" rel="noopener">Urbora</a> to make it easier to understand what you
          can build on any lot.
        </p>
        <p>
          Before Fernwood, I worked with historical land records at BC’s Land Title and Survey
          Authority and built <a class="text-link" href={site.munify} target="_blank" rel="noopener">Munify</a> to make council
          meetings easier to follow. I also lead development at
          <a class="text-link" href={site.polity} target="_blank" rel="noopener">Polity Cooperative</a>.
        </p>
      </div>
    </div>
  </main>

  <SiteFooter />
</Base>
